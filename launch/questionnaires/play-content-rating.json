    { "id": "sexualContent", "type": "level", "label": "성적 콘텐츠", "labelEn": "Sexual Content", "help": "성적 표현·암시의 정도." },
    { "id": "nudity", "type": "bool", "label": "노출", "labelEn": "Nudity", "help": "신체 노출이 있나요?" },

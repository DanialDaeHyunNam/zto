    { "id": "controlledSubstances", "type": "bool", "label": "주류·담배·약물", "labelEn": "Alcohol, Tobacco, or Drugs", "help": "술·담배·약물의 사용이나 묘사가 있나요?" },
    { "id": "gambling", "type": "bool", "label": "실제 도박", "labelEn": "Real Gambling", "help": "실제 돈을 걸 수 있나요? 대부분의 게임은 아니오." },
    { "id": "gamblingSimulated", "type": "bool", "label": "모의 도박", "labelEn": "Simulated Gambling", "help": "실제 돈 없이 도박을 흉내내나요(슬롯·카드 등)?" },
    { "id": "userInteraction", "type": "bool", "label": "이용자 간 상호작용", "labelEn": "Users Interact", "help": "채팅·메시지 등 이용자끼리 소통하나요? (싱글플레이면 아니오)" },
    { "id": "sharesLocation", "type": "bool", "label": "위치 공유", "labelEn": "Shares Location", "help": "이용자 위치를 다른 사람과 공유하나요?" },
    { "id": "digitalPurchases", "type": "bool", "label": "디지털 구매", "labelEn": "Digital Purchases", "help": "앱 안에서 디지털 상품을 구매할 수 있나요? IAP가 있으면 예." }

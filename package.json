{
  "name": "zto",
  "version": "0.1.15",
  "description": "ZTO (Zero to One) — 1인 개발사의 출시·계정·소셜·브랜딩 데스크톱 앱",
  "main": "./out/main/index.js",
  "author": "Dan",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "demo:profile": "bash scripts/demo-profile.sh",
    "eval": "node --experimental-strip-types scripts/eval-prompts.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac:official": "MAIN_VITE_OFFICIAL=1 electron-vite build && electron-builder --mac -c.publish.provider=generic -c.publish.url=\"${ZTO_UPDATE_URL:?ZTO_UPDATE_URL required}\" -c.mac.icon=build/icon-official.png"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-icons": "^16.27.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
